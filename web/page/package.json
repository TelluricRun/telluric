{
  "name": "@telluric/web.page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:staging": "export APP_ENV=staging && next build && echo 'User-agent: *' > out/robots.txt && echo 'Disallow: /' >> out/robots.txt",
    "build:production": "export APP_ENV=production && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@telluric/core": "workspace:*",
    "@telluric/ui": "workspace:*",
    "@next/third-parties": "^16.0.7",
    "next": "latest",
    "nodemailer": "^6.9.3",
    "react": "latest",
    "react-dom": "latest",
    "@supabase/supabase-js": "^2.34.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.26.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}